<view class="page" wx:if="{{found}}"><view class="tiny">好友分享的通用内容，不包含对方的个人得分或答案。</view><view wx:if="{{profile}}"><image class="scene" src="/assets/{{profile.illustrationId}}.png" mode="aspectFill"/><view class="card"><view class="huge">{{profile.type}}</view><view class="title">{{profile.title}}</view><view class="muted">{{profile.summary}}</view></view><view class="card"><view class="subtitle">性格优势</view><view wx:for="{{profile.strengths}}" wx:key="*this" class="list-item">{{item}}</view><view class="subtitle">可能的盲点</view><view wx:for="{{profile.blindSpots}}" wx:key="*this" class="list-item">{{item}}</view><view class="subtitle">人际相处</view><view wx:for="{{profile.relationships}}" wx:key="*this" class="list-item">{{item}}</view><view class="subtitle">学习 / 工作倾向</view><view wx:for="{{profile.workStudy}}" wx:key="*this" class="list-item">{{item}}</view><view class="subtitle">成长建议</view><view wx:for="{{profile.growthTips}}" wx:key="*this" class="list-item">{{item}}</view></view></view><view wx:if="{{fortune}}" class="card"><view class="title">{{fortune.title}}</view><view class="quote">{{fortune.mainText}}</view><view wx:for="{{fortune.description}}" wx:key="*this" class="list-item muted">{{item}}</view></view><button class="primary" bindtap="poster">生成同款分享卡</button><button class="secondary" bindtap="start">探索我的偏好</button><view class="tiny">偏好概括仅供参考，祝福不是未来预测。</view></view><view wx:else class="page"><view class="empty">分享内容不存在，欢迎从测试页开始。</view><button class="primary" bindtap="start">开始探索</button></view>