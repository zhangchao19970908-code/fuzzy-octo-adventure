<view class="page"><view class="title">{{kind==='tests'?'测试记录':kind==='fortunes'?'抽签记录':'我的卡片'}}</view><view class="tiny">仅保存在本机，最多保留最近 30 条。</view><view wx:if="{{!items.length}}" class="empty">这里还没有记录。去探索一次，留下今天的心情吧。</view><view wx:for="{{items}}" wx:key="id" class="card"><view data-id="{{item.id}}" bindtap="open"><view class="subtitle">{{item.label}}</view><view class="muted">{{item.date}}</view></view><view class="link" data-id="{{item.id}}" bindtap="remove">删除记录</view></view></view>