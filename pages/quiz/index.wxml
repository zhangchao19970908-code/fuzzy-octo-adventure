<view class="page" wx:if="{{ready}}"><view class="row"><text>{{index+1}} / {{total}}</text><text bindtap="exit">保存并退出</text></view><view class="bar"><view class="fill" style="width:{{progress}}%"/></view><view class="tiny" wx:if="{{fallback}}">为保持题目均衡，本次包含近期出现过的题目。</view><image wx:if="{{index%2===0}}" class="scene" src="/assets/{{question.illustrationId}}.png" mode="aspectFill"/><view class="card"><image wx:if="{{index%2===1}}" class="scene travel" src="/assets/{{question.illustrationId}}.png" mode="aspectFill"/><view class="question">{{question.text}}</view><view wx:for="{{options}}" wx:key="*this" class="option {{answer===index+1?'selected':''}}" data-value="{{index+1}}" bindtap="pick">{{item}}</view></view><view class="row"><button class="secondary" disabled="{{index===0}}" bindtap="prev">上一题</button><button class="primary" disabled="{{!answer}}" bindtap="next">{{index===total-1?'查看结果':'下一题'}}</button></view></view>