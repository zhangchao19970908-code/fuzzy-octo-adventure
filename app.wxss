page{background:#f6f9fc;color:#19334b;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}view,text,button{box-sizing:border-box}.page{padding:30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom))}.hero{height:540rpx;border-radius:38rpx;position:relative;overflow:hidden;background:linear-gradient(160deg,#58acf0,#bde6ff 65%,#f4f3d9)}.hero.warm{background:linear-gradient(150deg,#d8c2ee,#ffdcac 60%,#ffd3c5)}.hero image{width:100%;height:100%;position:absolute}.hero-title{position:absolute;left:38rpx;top:45rpx;font-size:46rpx;line-height:1.7;font-weight:600;max-width:550rpx}.hero-note{position:absolute;left:38rpx;top:170rpx;max-width:550rpx}.card{background:#fffdf8;border:1rpx solid #edf0f4;border-radius:30rpx;padding:30rpx;margin:24rpx 0;box-shadow:0 10rpx 32rpx #24476508}.title{font-size:40rpx;font-weight:650;margin-bottom:20rpx}.subtitle{font-size:31rpx;font-weight:600}.muted{color:#6a8097;line-height:1.7;font-size:25rpx}.primary{background:#193b56;color:white;border-radius:48rpx;margin:24rpx 0;font-size:29rpx}.secondary{background:#e9f2ff;color:#244561;border-radius:24rpx;margin:16rpx 0;font-size:27rpx}button:after{border:0}.row{display:flex;gap:20rpx;align-items:center}.row > view,.row > text,.row > button{flex:1;min-width:0}.pill{display:inline-block;padding:10rpx 20rpx;border-radius:30rpx;background:#eef4fb;margin:8rpx;font-size:24rpx}.option{padding:23rpx;border:2rpx solid #dce5ed;border-radius:22rpx;background:white;margin:14rpx 0;text-align:center}.option.selected{background:#dcefff;border-color:#488ec4;color:#143b5b}.scene{width:100%;height:300rpx;border-radius:25rpx;background:#def0fa}.scene.travel{height:360rpx}.bar{height:18rpx;background:#e6edf4;border-radius:20rpx;overflow:hidden;margin:14rpx 0}.fill{height:100%;background:#72b8e8}.huge{font-size:96rpx;font-weight:800;letter-spacing:6rpx;color:#173655}.list-item{padding:26rpx 0;border-bottom:1rpx solid #edf1f5;line-height:1.7}.poster{width:100%;height:1000rpx;border-radius:26rpx;background:#eff4fb}.error{color:#ad3e39;padding:16rpx;line-height:1.6}.empty{text-align:center;padding:70rpx 20rpx;color:#7a8fa2}canvas.poster-canvas{position:fixed;left:-3000px;top:0;width:600px;height:1000px}.tiny{font-size:23rpx;line-height:1.7;color:#7a8b9c}.quote{font-size:38rpx;line-height:1.6}.avatar{width:96rpx;height:96rpx;border-radius:50%;background:#d8eafb}.link{color:#316d9a;padding:18rpx 0} .loading{text-align:center;padding:30rpx}.question{font-size:35rpx;line-height:1.6;margin:30rpx 0}
.drawing image{animation:gentle-card .45s ease-in-out}@keyframes gentle-card{0%{transform:scale(1);opacity:1}50%{transform:scale(1.035);opacity:.75}100%{transform:scale(1);opacity:1}}
