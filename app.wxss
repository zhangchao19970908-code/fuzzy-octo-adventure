page{background:#faf8f2;color:#193d42;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,text,button{box-sizing:border-box}
.page{padding:30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom))}
.display,.title,.hero-title,.quote,.huge{font-family:ExplorerSerif,"Songti SC",STSong,"Noto Serif CJK SC",serif;font-weight:500}
.title{font-size:40rpx;line-height:1.4;margin-bottom:22rpx}.subtitle{font-size:31rpx;font-weight:600}.muted{color:#7b8785;font-size:25rpx;line-height:1.7}.tiny{font-size:23rpx;line-height:1.7;color:#8a918c}
.hero{position:relative;overflow:hidden;border-radius:36rpx;height:590rpx;background:#e8eeeb}.hero image{width:100%;height:100%;position:absolute}.hero-shade{position:absolute;left:0;top:0;right:0;height:58%;background:linear-gradient(180deg,#faf8f2c9,#faf8f200)}
.hero-title{position:absolute;top:42rpx;left:42rpx;right:42rpx;font-size:48rpx;line-height:1.45;color:#133b42}.hero-note{position:absolute;top:190rpx;left:42rpx;right:42rpx;font-size:25rpx;color:#526766}.card{padding:30rpx;background:#fffdf8;border:1rpx solid #e9e5da;border-radius:28rpx;margin:24rpx 0;box-shadow:0 10rpx 36rpx #27362f06}
button{padding:0 22rpx;font-size:28rpx;line-height:84rpx;font-family:inherit}button:after{border:0}.primary{color:#fffdf5;background:#194d53;border:1rpx solid #beaa73;border-radius:44rpx;margin:20rpx 0}.secondary{background:#fffdf8;color:#294c50;border:1rpx solid #dad8ca;border-radius:32rpx;margin:20rpx 0}.row{display:flex;align-items:center;gap:20rpx}.row > view,.row > text,.row > button{flex:1;min-width:0}.pill{display:inline-block;padding:8rpx 18rpx;background:#f1eee4;border-radius:30rpx;margin:6rpx;font-size:23rpx;color:#65736d}
.bar{height:10rpx;background:#e8e8df;border-radius:10rpx;overflow:hidden;margin:18rpx 0}.fill{height:100%;background:#32727a;border-radius:10rpx}.huge{font-size:100rpx;letter-spacing:5rpx;line-height:1.3}.scene{width:100%;height:350rpx;border-radius:26rpx}.list-item{padding:24rpx 0;border-bottom:1rpx solid #eeece3;line-height:1.7}.link{color:#506d69;padding:18rpx 0}.empty{padding:80rpx 24rpx;text-align:center;color:#82908a}.error{padding:20rpx;color:#a44e42}.loading{padding:50rpx;text-align:center;color:#6c807c}.quote{font-size:39rpx;line-height:1.7}.poster{width:100%;height:1090rpx;background:#eeeee7;border-radius:26rpx}canvas.poster-canvas{position:fixed;left:-4000px;top:0;width:720px;height:1200px}
.home-page{padding:0 0 calc(24rpx + env(safe-area-inset-bottom));background:#faf8f2}.home-art{height:690rpx;border-radius:0}.home-art .hero-title{text-align:center;top:65rpx}.home-sheet{position:relative;margin:-48rpx 0 0;border-radius:60rpx 60rpx 0 0;background:#faf8f2;padding:32rpx 30rpx}.section-heading{text-align:center;font-size:39rpx;font-family:ExplorerSerif,"Songti SC",serif}.section-note{text-align:center;font-size:24rpx;color:#83918b;margin:10rpx 0 28rpx}.entry-grid{display:flex;gap:22rpx}.test-entry{flex:1;min-width:0;border-radius:23rpx;background:#fffefa;border:1rpx solid #e8e3d6;padding:14rpx;box-shadow:0 8rpx 20rpx #2f483209}.entry-image{width:100%;height:240rpx;border-radius:17rpx}.entry-name{font-size:28rpx;margin:14rpx 0 4rpx;font-weight:600}.entry-time{font-size:23rpx;color:#85908c}.disclaimer{padding:14rpx 0;font-size:21rpx;color:#8b938e;line-height:1.7}.recent-link{padding:24rpx 8rpx;border-bottom:1rpx solid #e8e5db;font-size:26rpx;color:#4d6864}
.fortune-stage{height:1000rpx;position:relative;overflow:hidden}.fortune-stage image{position:absolute;width:100%;height:100%}.fortune-heading{position:absolute;top:68rpx;left:44rpx;right:44rpx;color:#fff7e6;font-family:ExplorerSerif,"Songti SC",serif;font-size:47rpx;line-height:1.5;text-shadow:0 2rpx 16rpx #0b252dcc}.fortune-stage .primary{position:absolute;bottom:60rpx;left:80rpx;right:80rpx}.benefits{display:flex;justify-content:space-around;margin:0;padding:28rpx 18rpx;text-align:center;border-radius:35rpx 35rpx 0 0}.benefits .tiny{margin-top:8rpx}.skip-link{position:absolute;bottom:18rpx;left:0;right:0;text-align:center;color:#fff8e8;font-size:23rpx}.drawing image{animation:turn-card .45s ease-in-out}@keyframes turn-card{0%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(1.02)}100%{opacity:1;transform:scale(1)}}
.mine-art{height:420rpx;border-radius:0}.mine-title{font-size:44rpx;top:44rpx}.mine-profile{position:absolute;right:42rpx;bottom:40rpx;width:140rpx;height:140rpx;border-radius:50%;border:5rpx solid #fffdf8;overflow:hidden}.mine-profile image{position:static;width:100%;height:100%}.mine-sheet{padding:0 30rpx;margin-top:-28rpx;position:relative}.mine-link{display:flex;gap:24rpx;align-items:center;padding:26rpx 0;border-bottom:1rpx solid #eee9dd}.mine-icon{width:48rpx;height:48rpx}.mine-copy{flex:1}.chevron{font-size:33rpx;color:#8b917d}.mine-footer{text-align:center;padding:40rpx 0;color:#89968e;font-family:ExplorerSerif,"Songti SC",serif}
.quiz-page{padding:24rpx 26rpx calc(30rpx + env(safe-area-inset-bottom))}.quiz-top{display:flex;align-items:center;justify-content:space-between;padding:4rpx 8rpx}.counter{font-size:32rpx}.exit{font-size:25rpx;color:#627973}.notice{font-size:22rpx;color:#837d68;padding:12rpx 6rpx}.quiz-sheet{border-radius:26rpx;overflow:hidden;background:#fffefa;border:1rpx solid #ede8dc;margin-top:24rpx}.quiz-scene{width:100%;height:340rpx;display:block}.scene-above{background:transparent;border:0}.scene-above .quiz-scene{border-radius:26rpx}.scene-above .quiz-body{margin-top:22rpx;border:1rpx solid #ede8dc;border-radius:26rpx;background:#fffefa}.scene-header .quiz-scene{height:380rpx}.quiz-body{padding:26rpx}.question{font-size:30rpx;line-height:1.75;color:#233f42}.answer-hint{font-size:22rpx;color:#8d978f;margin:12rpx 0 22rpx}.answer{display:flex;gap:18rpx;align-items:center;padding:18rpx 20rpx;min-height:78rpx;border:1rpx solid #e5e1d6;border-radius:18rpx;margin:12rpx 0;background:#fffefa;font-size:26rpx;line-height:1.5}.answer.selected{background:#e6efec;border-color:#6da2a2;color:#17494e}.radio{width:29rpx;height:29rpx;flex-shrink:0;border:2rpx solid #bdc5bb;border-radius:50%;display:flex;align-items:center;justify-content:center}.selected .radio{border-color:#31747b}.radio-dot{width:17rpx;height:17rpx;border-radius:50%;background:#31747b}.replace-link{text-align:center;font-size:23rpx;color:#8d9484;padding:15rpx 0 0}.quiz-footer{display:flex;gap:22rpx;padding-top:10rpx}.quiz-footer button{flex:1}.result-hero{position:relative;height:420rpx;border-radius:28rpx;overflow:hidden}.result-hero image{width:100%;height:100%}.source-label{font-size:24rpx;color:#78857c;line-height:1.7;margin-top:28rpx}
